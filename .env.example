# Copy to .env next to this file. The process environment overrides these values.
# Lines are KEY=VALUE. Blank lines and lines starting with # are ignored.
# Optional surrounding quotes and an "export " prefix are stripped.

# Name registered with the Service Control Manager; also the virtual account name (NT SERVICE\<name>).
SERVICE_NAME=FastApiWorker
SERVICE_DISPLAY_NAME=FastAPI Worker (reference)

# Interface and port uvicorn binds. Keep 127.0.0.1 unless a remote caller needs the port.
HOST=127.0.0.1
PORT=8010

# Stands in for anything the real worker cannot run without (an API key, a connection string).
# Readiness reports 503 while it is empty. No remote call is made to check it.
REQUIRED_SETTING=set-me

# DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
